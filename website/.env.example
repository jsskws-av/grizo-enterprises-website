# Grizo Enterprises - Website Environment Configuration Example
# Copy this file to .env.local for local testing or set these variables in your deployment dashboard (e.g., Vercel, Netlify).

# 1. Public Website URL (Configured for your registered GoDaddy domain)
NEXT_PUBLIC_SITE_URL=https://www.grizoenterprises.co.in

# 2. Official Business Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=jsskws.av@gmail.com

# Optional: Business phone number for public display (leave empty if not displaying)
NEXT_PUBLIC_CONTACT_PHONE=

# Optional: Registered office address for public display (leave empty if privacy-sensitive)
NEXT_PUBLIC_BUSINESS_ADDRESS=

# Optional: GSTIN for public display (leave empty if keeping confidential)
NEXT_PUBLIC_BUSINESS_GSTIN=

# 3. Contact Form Backend Activation
# Set to 'true' only after connecting a production email dispatch API (e.g., Resend, AWS SES)
NEXT_PUBLIC_ENABLE_CONTACT_BACKEND=false
